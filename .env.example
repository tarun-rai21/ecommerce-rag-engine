QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
COLLECTION_NAME=wands_products
GROQ_API_KEY=your_groq_api_key_here
REDIS_HOST=localhost
REDIS_PORT=6379

# API safeguards: leave empty for local development; set all of them for a public deployment.
# Comma-separated keys accepted in the X-API-Key header:
API_KEYS=
# The key the Streamlit UI sends (one of API_KEYS):
FRONTEND_API_KEY=
# Requests per minute per client; 0 = off. /ask calls the paid LLM, so keep it lower.
RATE_LIMIT_PER_MINUTE=0
ASK_RATE_LIMIT_PER_MINUTE=0
