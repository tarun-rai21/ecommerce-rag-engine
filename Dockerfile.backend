# ── Stage 1: install dependencies ─────────────────────────
# Every dependency ships a prebuilt wheel for Linux x86-64, so no compiler is needed.
FROM python:3.11-slim AS builder

ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /build
COPY requirements-backend.txt .
RUN pip install --prefix=/install -r requirements-backend.txt

# ── Stage 2: runtime ──────────────────────────────────────
FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FASTEMBED_CACHE_PATH=/app/models \
    HF_HUB_DISABLE_TELEMETRY=1

RUN useradd --create-home --uid 10001 app
WORKDIR /app

COPY --from=builder /install /usr/local
COPY config/ ./config/
COPY src/backend/ ./src/backend/
COPY src/ingestion/ ./src/ingestion/

# Bake both embedding models (~65 MB) into the image: containers start without
# downloading anything, and a host with no access to Hugging Face still works.
RUN python -c "from src.ingestion.embedder import ProductEmbedder; ProductEmbedder()" \
    && chown -R app:app /app/models
# From here on, never reach out to the Hugging Face Hub.
ENV HF_HUB_OFFLINE=1

USER app
EXPOSE 8000

# Behind a reverse proxy, set FORWARDED_ALLOW_IPS to the proxy's address (or "*" when
# the proxy is the only way in) so rate limits see the caller's IP, not the proxy's.
CMD ["uvicorn", "src.backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
